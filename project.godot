; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pokemon Rojo Oscuro"
run/main_scene="res://Scene/DontDestroy/Portada/Portada.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/PokemonIA"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.070588, 0.011765, 0.027451, 1)
boot_splash/use_filter=false
boot_splash/image="res://Graphics/Identidad/inicio.png"
config/icon="res://Graphics/Identidad/icono.png"

[autoload]

ControlEntrada="*res://Scene/DontDestroy/Controles/ControlEntrada.gd"
Partida="*res://Scene/DontDestroy/iniciarpartida/Partida.gd"

[display]

window/size/viewport_width=576
window/size/viewport_height=384
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/item_spawner/plugin.cfg")

